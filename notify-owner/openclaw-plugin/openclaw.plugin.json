{
  "id": "magclaw-notify",
  "name": "MagClaw Notify",
  "description": "Hosts the MagClaw Notify Relay, durable state machine, Feishu delivery, and approvals inside OpenClaw.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bindings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "channel", "accountId"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$" },
            "name": { "type": "string", "minLength": 1 },
            "channel": { "type": "string", "enum": ["feishu"] },
            "accountId": { "type": "string", "minLength": 1 },
            "enabled": { "type": "boolean", "default": true },
            "legacy": { "type": "boolean", "default": false }
          }
        },
        "default": []
      },
      "accountId": {
        "type": "string",
        "minLength": 1
      },
      "notifyHome": {
        "type": "string",
        "minLength": 1
      },
      "instance": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
      },
      "relayEnabled": {
        "type": "boolean",
        "default": false
      },
      "relayUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "autoUpdate": {
        "type": "boolean",
        "default": true
      },
      "memberAgentId": {
        "type": "string",
        "minLength": 1
      },
      "projectName": {
        "type": "string",
        "minLength": 1
      },
      "memberReadTools": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true,
        "default": []
      }
    }
  }
}
