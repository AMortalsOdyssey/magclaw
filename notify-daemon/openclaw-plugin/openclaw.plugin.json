{
  "id": "magclaw-notify",
  "name": "MagClaw Notify",
  "description": "Hosts the MagClaw Notify Relay, durable state machine, Feishu delivery, and approvals inside OpenClaw.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "accountId": {
        "type": "string",
        "minLength": 1
      },
      "notifyHome": {
        "type": "string",
        "minLength": 1
      },
      "instance": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
      },
      "relayEnabled": {
        "type": "boolean",
        "default": false
      },
      "relayUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "memberAgentId": {
        "type": "string",
        "minLength": 1
      },
      "projectName": {
        "type": "string",
        "minLength": 1
      },
      "memberReadTools": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true,
        "default": []
      }
    }
  }
}
